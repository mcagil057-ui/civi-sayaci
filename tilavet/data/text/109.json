{"n":109,"ayetler":[{"v":1,"u":"قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ","m":"De ki: \"Ey inkarcılar","l":"Kul ya eyyühel kafirun"},{"v":2,"u":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ","m":"Ben sizin taptıklarınıza tapmam","l":"La a´büdü ma ta´büdun"},{"v":3,"u":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","m":"Benim taptığıma da sizler tapmazsınız","l":"Ve la entüm abidune ma a´büd"},{"v":4,"u":"وَلَآ أَنَا۠ عَابِدࣱ مَّا عَبَدتُّمۡ","m":"Ben de sizin taptığınıza tapacak değilim","l":"Ve la ene abidün ma abedtüm"},{"v":5,"u":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","m":"Benim taptığıma da sizler tapmıyorsunuz","l":"Ve la entüm abidune ma a´büd"},{"v":6,"u":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ","m":"Sizin dininiz size, benim dinim banadır","l":"Leküm diynüküm ve liye din"}]}