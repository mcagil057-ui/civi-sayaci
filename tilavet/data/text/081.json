{"n":81,"ayetler":[{"v":1,"u":"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ","m":"Güneş katlanıp dürüldüğünde","l":"İzeşşemsu kuvviret"},{"v":2,"u":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ","m":"Yıldızlar (kararıp) döküldüğünde","l":"Ve izennucumunkederet"},{"v":3,"u":"وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ","m":"Dağlar (sallanıp) yürütüldüğünde","l":"Ve izelcibalu suyyiret"},{"v":4,"u":"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ","m":"Gebe develer salıverildiğinde","l":"Ve izel´işaru ´uttılet"},{"v":5,"u":"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ","m":"Vahşi hayvanlar toplanıp bir araya getirildiğinde","l":"Ve izelvuhuşu huşiret"},{"v":6,"u":"وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ","m":"Denizler kaynatıldığında","l":"Ve izelbiharu succiret"},{"v":7,"u":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ","m":"Ruhlar (bedenlerle) birleştirildiğinde","l":"Ve izennufusu zuvvicet"},{"v":8,"u":"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ","m":"Diri diri toprağa gömülen kıza, sorulduğunda","l":"Ve izelmev´udetu suilet"},{"v":9,"u":"بِأَيِّ ذَنۢبࣲ قُتِلَتۡ","m":"Hangi günah sebebiyle öldürüldü? diye","l":"Bieyyi zenbin kutilet"},{"v":10,"u":"وَإِذَا ٱلصُّحُفُ نُشِرَتۡ","m":"(Amellerin yazılı olduğu) defterler açıldığında","l":"Ve izessuhufu nuşiret"},{"v":11,"u":"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ","m":"Gökyüzü sıyrılıp alındığında","l":"Ve izessema´u kuşitat"},{"v":12,"u":"وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ","m":"Cehennem tutuşturulduğunda","l":"Ve izelcahıymu su´´ıret"},{"v":13,"u":"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ","m":"Ve cennet yaklaştırıldığında","l":"Ve izelcennetu uzlifet"},{"v":14,"u":"عَلِمَتۡ نَفۡسࣱ مَّآ أَحۡضَرَتۡ","m":"Kişi neler getirdiğini öğrenmiş olacaktır","l":"´Alimet nefsun ma ahdaret"},{"v":15,"u":"فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ","m":"Şimdi yemin ederim o sinenlere","l":"Fela uksimu bilhunnesi"},{"v":16,"u":"ٱلۡجَوَارِ ٱلۡكُنَّسِ","m":"O akıp akıp yuvasına gidenlere","l":"Elcevarilkunnesi"},{"v":17,"u":"وَٱلَّيۡلِ إِذَا عَسۡعَسَ","m":"Kararmaya yüz tuttuğunda geceye andolsun","l":"Velleyli iza ´as´ase"},{"v":18,"u":"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ","m":"Ağarmaya başladığında sabaha andolsun ki","l":"Vessubhı iza teneffese"},{"v":19,"u":"إِنَّهُۥ لَقَوۡلُ رَسُولࣲ كَرِيمࣲ‏","m":"O (Kur'an), şüphesiz değerli, bir elçinin (Cebrail'in) getirdiği sözdür","l":"İnnehu lekalu resulin keriymin"},{"v":20,"u":"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينࣲ‏","m":"O elçi güçlü, Arş'ın sahibi (Allah'ın) katında çok itibarlıdır","l":"Ziy kuvvetin ´ınde ziyl´arşi mekiynin"},{"v":21,"u":"مُّطَاعࣲ ثَمَّ أَمِينࣲ‏","m":"O orada sayılan, güvenilen (bir elçi) dir","l":"Muta´ın semme emiynin"},{"v":22,"u":"وَمَا صَاحِبُكُم بِمَجۡنُونࣲ‏","m":"Arkadaşınız (Muhammed) de mecnun değildir","l":"Ve ma sahıbukum bimecnunin"},{"v":23,"u":"وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ","m":"Andolsun ki, onu (Cebrail'i) apaçık ufukta görmüştür","l":"Ve lekad reahu bil´ufukılmubiyni"},{"v":24,"u":"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينࣲ‏","m":"O, gaybın bilgilerini (sizden) esirgemez","l":"Ve ma huve ´alelğaybi bidaniynin"},{"v":25,"u":"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنࣲ رَّجِيمࣲ‏","m":"O lanetlenmiş şeytanın sözü de değildir","l":"Ve ma huve bikavli şeytanin reciymin"},{"v":26,"u":"فَأَيۡنَ تَذۡهَبُونَ","m":"Hal böyle iken nereye gidiyorsunuz","l":"Feeyne tezhebune"},{"v":27,"u":"إِنۡ هُوَ إِلَّا ذِكۡرࣱ لِّلۡعَٰلَمِينَ","m":"O, herkes için, bir öğüttür","l":"İn huve illa zikrun lil´alemiyne"},{"v":28,"u":"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ","m":"Sizden doğru yolda gitmek isteyenler için de","l":"Limen şae minkum en yestekıyme"},{"v":29,"u":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ","m":"Alemlerin Rabbi Allah dilemedikçe siz dileyemezsiniz","l":"Ve ma teşaune illa en yeşaallahu rabbul´alemiyne"}]}