{"n":112,"ayetler":[{"v":1,"u":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","m":"De ki: O, Allah birdir","l":"Kul hüvallahü ehad"},{"v":2,"u":"ٱللَّهُ ٱلصَّمَدُ","m":"Allah sameddir","l":"Allahüs samed"},{"v":3,"u":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","m":"O, doğurmamış ve doğmamıştır","l":"Lem yelid ve lem yuled"},{"v":4,"u":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","m":"Onun hiçbir dengi yoktur","l":"Ve lem yekün lehu küfüven ehad"}]}