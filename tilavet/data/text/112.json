{"n":112,"ayetler":[{"v":1,"u":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","m":"De ki: O Allah bir tektir","l":"Kul hüvallahü ehad"},{"v":2,"u":"ٱللَّهُ ٱلصَّمَدُ","m":"Allah her şeyden müstağni ve her şey O'na muhtaçtır","l":"Allahüs samed"},{"v":3,"u":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","m":"O doğurmamış ve doğmamıştır","l":"Lem yelid ve lem yuled"},{"v":4,"u":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","m":"Hiçbir şey O'na denk değildir","l":"Ve lem yekün lehu küfüven ehad"}]}