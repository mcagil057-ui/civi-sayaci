{"n":93,"ayetler":[{"v":1,"u":"وَٱلضُّحَىٰ","m":"Andolsun kuşluk vaktine","l":"Vedduha"},{"v":2,"u":"وَٱلَّيۡلِ إِذَا سَجَىٰ","m":"Ve sükuna erdiğinde geceye ki","l":"Velleyli iza seca"},{"v":3,"u":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","m":"Rabbin seni bırakmadı ve sana darılmadı","l":"Ma vedde´ake rabbüke ve ma kala"},{"v":4,"u":"وَلَلۡأٓخِرَةُ خَيۡرࣱ لَّكَ مِنَ ٱلۡأُولَىٰ","m":"Gerçekten senin için ahiret dünyadan daha hayırlıdır","l":"Ve lel´ahıretü hayrün leke minel´ula"},{"v":5,"u":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ","m":"Pek yakında Rabbin sana verecek de hoşnut olacaksın","l":"Ve lesevfe yu´tıyke rabbüke feterda"},{"v":6,"u":"أَلَمۡ يَجِدۡكَ يَتِيمࣰا فَـَٔاوَىٰ","m":"O, seni yetim bulup barındırmadı mı","l":"Elem yecidke yetiymen feava"},{"v":7,"u":"وَوَجَدَكَ ضَآلࣰّا فَهَدَىٰ","m":"Şaşırmış bulup da yol göstermedi mi","l":"Ve vecedeke dallen feheda"},{"v":8,"u":"وَوَجَدَكَ عَآئِلࣰا فَأَغۡنَىٰ","m":"Seni fakir bulup zengin etmedi mi","l":"Ve vecedeke ´ailen feağna"},{"v":9,"u":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ","m":"Öyleyse yetimi sakın ezme","l":"Femmel yetiyme fela takher"},{"v":10,"u":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ","m":"El açıp isteyeni de sakın azarlama","l":"Ve emmessaile fela tenher"},{"v":11,"u":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ","m":"Ve Rabbinin nimetini minnet ve şükranla an","l":"Ve emma binı´meti rabbike fehaddis"}]}