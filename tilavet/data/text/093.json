{"n":93,"ayetler":[{"v":1,"u":"وَٱلضُّحَىٰ","m":"Kuşluk vaktine and olsun","l":"Vedduha"},{"v":2,"u":"وَٱلَّيۡلِ إِذَا سَجَىٰ","m":"Sükun erdiği zaman geceye and olsun ki","l":"Velleyli iza seca"},{"v":3,"u":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","m":"Rabbin seni ne bıraktı ve ne de sana darıldı","l":"Ma vedde´ake rabbüke ve ma kala"},{"v":4,"u":"وَلَلۡأٓخِرَةُ خَيۡرࣱ لَّكَ مِنَ ٱلۡأُولَىٰ","m":"Doğrusu ahiret senin için dünyadan daha hayırlıdır","l":"Ve lel´ahıretü hayrün leke minel´ula"},{"v":5,"u":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ","m":"Rabbin şüphesiz sana verecek ve sen de hoşnut olacaksın","l":"Ve lesevfe yu´tıyke rabbüke feterda"},{"v":6,"u":"أَلَمۡ يَجِدۡكَ يَتِيمࣰا فَـَٔاوَىٰ","m":"Seni öksüz bulup da barındırmadı mı","l":"Elem yecidke yetiymen feava"},{"v":7,"u":"وَوَجَدَكَ ضَآلࣰّا فَهَدَىٰ","m":"Seni şaşırmış bulup, doğru yola eriştirmedi mi","l":"Ve vecedeke dallen feheda"},{"v":8,"u":"وَوَجَدَكَ عَآئِلࣰا فَأَغۡنَىٰ","m":"Seni fakir bulup zenginleştirmedi mi","l":"Ve vecedeke ´ailen feağna"},{"v":9,"u":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ","m":"Öyleyse sakın öksüze kötü muamele etme","l":"Femmel yetiyme fela takher"},{"v":10,"u":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ","m":"Ve sakın bir şey isteyeni azarlama","l":"Ve emmessaile fela tenher"},{"v":11,"u":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ","m":"Yalnızca Rabbinin nimetini anlat","l":"Ve emma binı´meti rabbike fehaddis"}]}