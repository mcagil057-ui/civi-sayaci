{"n":107,"ayetler":[{"v":1,"u":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","m":"Dini yalanlayanı gördün mü","l":"E raeytellezi yükezzibü bid din"},{"v":2,"u":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","m":"İşte o, yetimi itip kakar","l":"Fe zalikellezi yedu´ul yetim"},{"v":3,"u":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","m":"Yoksulu doyurmaya teşvik etmez","l":"Ve la yehuddu ala taamil miskin"},{"v":4,"u":"فَوَيۡلࣱ لِّلۡمُصَلِّينَ","m":"Yazıklar olsun o namaz kılanlara ki","l":"Fe veylün lil müsallin"},{"v":5,"u":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","m":"Onlar namazlarını ciddiye almazlar","l":"Ellezine hüm an salatihim sahun"},{"v":6,"u":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","m":"Onlar gösteriş yapanlardır","l":"Ellezine hüm yüraun"},{"v":7,"u":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","m":"Ve hayra da mani olurlar","l":"Ve yemneunel maun"}]}