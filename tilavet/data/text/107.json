{"n":107,"ayetler":[{"v":1,"u":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","m":"Dini yalan sayanı gördün mü","l":"E raeytellezi yükezzibü bid din"},{"v":2,"u":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","m":"Öksüzü kakıştıran, yoksulu doyurmaya yanaşmayan kimse işte odur","l":"Fe zalikellezi yedu´ul yetim"},{"v":3,"u":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","m":"Öksüzü kakıştıran, yoksulu doyurmaya yanaşmayan kimse işte odur","l":"Ve la yehuddu ala taamil miskin"},{"v":4,"u":"فَوَيۡلࣱ لِّلۡمُصَلِّينَ","m":"Vay o namaz kılanların haline ki","l":"Fe veylün lil müsallin"},{"v":5,"u":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","m":"Onlar kıldıkları namazdan gafildirler","l":"Ellezine hüm an salatihim sahun"},{"v":6,"u":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","m":"Onlar gösteriş yaparlar","l":"Ellezine hüm yüraun"},{"v":7,"u":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","m":"Onlar basit şeyleri dahi vermezler","l":"Ve yemneunel maun"}]}