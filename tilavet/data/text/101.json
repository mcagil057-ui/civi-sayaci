{"n":101,"ayetler":[{"v":1,"u":"ٱلۡقَارِعَةُ","m":"Gürültü koparacak olan","l":"El kariah"},{"v":2,"u":"مَا ٱلۡقَارِعَةُ","m":"Nedir o gürültü koparacak olan","l":"Mel kariah"},{"v":3,"u":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","m":"O gürültü koparacak olanın ne olduğunu sen bilir misin","l":"Ve ma edrake mel kariah"},{"v":4,"u":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","m":"O gün insanlar, ateş etrafında çırpınıp dökülen pervaneye dönecekler","l":"Yevme yekunün nasü kelferaşil mebsus"},{"v":5,"u":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","m":"Dağlar, atılmış renkli yüne benzeyecekler","l":"Ve tekunül cibalü kelıhnil menfuş"},{"v":6,"u":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","m":"Ama tartıları ağır gelen kimse hoş bir hayat içinde olacaktır","l":"Fe emma men sekulet mevazınüh"},{"v":7,"u":"فَهُوَ فِي عِيشَةࣲ رَّاضِيَةࣲ‏","m":"Ama tartıları ağır gelen kimse hoş bir hayat içinde olacaktır","l":"Fe hüve fi ıyşetir radıyeh"},{"v":8,"u":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","m":"Tartıları hafif gelenler ise","l":"Ve emma men haffet mevazınüh"},{"v":9,"u":"فَأُمُّهُۥ هَاوِيَةࣱ‏","m":"Onların yeri bir çukurdur","l":"Fe ümmühu havıyeh"},{"v":10,"u":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","m":"O çukurun ne olduğunu sen bilir misin","l":"Ve ma edrake mahiyeh"},{"v":11,"u":"نَارٌ حَامِيَةُۢ","m":"O, kızgın bir ateştir","l":"Narun hamiyeh"}]}