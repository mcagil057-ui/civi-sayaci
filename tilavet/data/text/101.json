{"n":101,"ayetler":[{"v":1,"u":"ٱلۡقَارِعَةُ","m":"Kapı çalan","l":"El kariah"},{"v":2,"u":"مَا ٱلۡقَارِعَةُ","m":"Nedir o kapı çalan","l":"Mel kariah"},{"v":3,"u":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","m":"O kapı çalanın ne olduğunu bilir misin","l":"Ve ma edrake mel kariah"},{"v":4,"u":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","m":"İnsanların, ateşin etrafını sarmış pervaneler gibi olur","l":"Yevme yekunün nasü kelferaşil mebsus"},{"v":5,"u":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","m":"Dağların da atılmış renkli yüne dönüştüğü gündür (o Karia)","l":"Ve tekunül cibalü kelıhnil menfuş"},{"v":6,"u":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","m":"O gün kimin tartılan ameli ağır gelirse","l":"Fe emma men sekulet mevazınüh"},{"v":7,"u":"فَهُوَ فِي عِيشَةࣲ رَّاضِيَةࣲ‏","m":"İşte o, hoşnut edici bir yaşayış içinde olur","l":"Fe hüve fi ıyşetir radıyeh"},{"v":8,"u":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","m":"Ameli yeğni olana gelince","l":"Ve emma men haffet mevazınüh"},{"v":9,"u":"فَأُمُّهُۥ هَاوِيَةࣱ‏","m":"İşte onun anası (yeri, yurdu) Haviye'dir","l":"Fe ümmühu havıyeh"},{"v":10,"u":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","m":"Nedir o (Haviye) bilir misin","l":"Ve ma edrake mahiyeh"},{"v":11,"u":"نَارٌ حَامِيَةُۢ","m":"Kızgın ateş","l":"Narun hamiyeh"}]}