{"n":88,"ayetler":[{"v":1,"u":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ","m":"(Resulüm!) Dehşeti her şeyi kaplayan kıyametin haberi sana geldi mi","l":"Hel etake hadiysülğaşiyeti"},{"v":2,"u":"وُجُوهࣱ يَوۡمَئِذٍ خَٰشِعَةٌ","m":"O gün bir takım yüzler zelildir","l":"Vücuhün yevmeizin haşi´atün"},{"v":3,"u":"عَامِلَةࣱ نَّاصِبَةࣱ‏","m":"Durmadan çalışır, (fakat boşuna) yorulur","l":"´Amiletün nasıbetün"},{"v":4,"u":"تَصۡلَىٰ نَارًا حَامِيَةࣰ‏","m":"Kızgın ateşe girer","l":"Tasla naren hamiyeten"},{"v":5,"u":"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةࣲ‏","m":"Onlara kaynar su pınarından içirilir","l":"Tüska min ´aynin aniyetin"},{"v":6,"u":"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعࣲ‏","m":"Onlar için kuru dikenden başka yemek yoktur","l":"Leyse lehüm ta´amün illa min dariy´ın"},{"v":7,"u":"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعࣲ‏","m":"O ise ne besler ne de açlığı giderir","l":"La yüsminü ve la yuğniy min cu´ın"},{"v":8,"u":"وُجُوهࣱ يَوۡمَئِذࣲ نَّاعِمَةࣱ‏","m":"O gün bir takım yüzler de vardır ki, mutludurlar","l":"Vücuhün yevmeizin na´ımetün"},{"v":9,"u":"لِّسَعۡيِهَا رَاضِيَةࣱ‏","m":"(dünyadaki) çabalarından hoşnut olmuşlardır","l":"Lisa´yiha radıyetün"},{"v":10,"u":"فِي جَنَّةٍ عَالِيَةࣲ‏","m":"Yüce bir cennettedirler","l":"Fiy cennetin ´aliyetin"},{"v":11,"u":"لَّا تَسۡمَعُ فِيهَا لَٰغِيَةࣰ‏","m":"Orada boş bir söz işitmezler","l":"La tesme´u fiyha lağıyeten"},{"v":12,"u":"فِيهَا عَيۡنࣱ جَارِيَةࣱ‏","m":"Orada (cennette) devamlı akan bir pınar","l":"Fiyha ´aynün cariyetün"},{"v":13,"u":"فِيهَا سُرُرࣱ مَّرۡفُوعَةࣱ‏","m":"Yükseltilmiş tahtlar","l":"Fiyha sürürin merfu´atün"},{"v":14,"u":"وَأَكۡوَابࣱ مَّوۡضُوعَةࣱ‏","m":"Konulmuş kadehler","l":"Ve ekvabün mevdu´atün"},{"v":15,"u":"وَنَمَارِقُ مَصۡفُوفَةࣱ‏","m":"Sıra sıra dizilmiş yastıklar","l":"Ve nemariku masfufetün"},{"v":16,"u":"وَزَرَابِيُّ مَبۡثُوثَةٌ","m":"Serilmiş halılar vardır","l":"Ve zerabiyyü mebsusetün"},{"v":17,"u":"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ","m":"(İnsanlar) devenin nasıl yaratıldığına, bakmazlar mı","l":"Efela yenzurune ilel´ibilli keyfe hulikat"},{"v":18,"u":"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ","m":"Göğe bakmıyorlar mı nasıl yükseltilmiş","l":"Ve ilessemai keyfe rufi´at"},{"v":19,"u":"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ","m":"Dağların nasıl dikildiğine, bakmazlar mı","l":"Ve ilelcibali keyfe nusıbet"},{"v":20,"u":"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ","m":"Yeryüzünün nasıl yayıldığına bir bakmazlar mı","l":"Ve ilel´ardı keyfe sutihat"},{"v":21,"u":"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرࣱ‏","m":"O halde (Resulüm), öğüt ver. Çünkü sen ancak öğüt vericisin","l":"Fezekkir innema ente müzekkirün"},{"v":22,"u":"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ","m":"Onların üzerinde bir zorba değilsin","l":"Leste´aleyhim bimusaytırin"},{"v":23,"u":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","m":"Ancak yüz çevirir inkar ederse","l":"İlla men tevella ve kefere"},{"v":24,"u":"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ","m":"İşte öylesini Allah en büyük azap ile cezalandırır","l":"Feyü´azzibühullahül´azabel´ekbere"},{"v":25,"u":"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ","m":"Şüphesiz onların dönüşü sadece bizedir","l":"İnne ileyna iyabehüm"},{"v":26,"u":"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم","m":"Sonra onların sorguya çekilmesi de sadece bize aittir","l":"Sümme inne ´aleyna hısabehüm"}]}