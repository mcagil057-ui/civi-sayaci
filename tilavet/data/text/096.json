{"n":96,"ayetler":[{"v":1,"u":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","m":"Yaratan Rabbinin adıyla oku","l":"Ikre´ bismi rabbikelleziy halak"},{"v":2,"u":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","m":"O, insanı bir aşılanmış yumurtadan yarattı","l":"Halekal´insane min ´alak"},{"v":3,"u":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","m":"Oku! Rabbin, en büyük kerem sahibidir","l":"Ikre´ ve rabbükel´ekrem"},{"v":4,"u":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","m":"O Rab ki kalemle (yazmayı) öğretti","l":"Elleziy ´alleme bilkalem"},{"v":5,"u":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","m":"İnsana bilmedikleri şeyi öğretti","l":"Allemel´insane ma lem ya´lem"},{"v":6,"u":"كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ","m":"Gerçek şu ki, insan azar","l":"Kella innel´insane leyatğa"},{"v":7,"u":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ","m":"Kendini kendine yeterli gördüğü için","l":"Erra a hustağn"},{"v":8,"u":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ","m":"Kuşkusuz dönüş Rabbinedir","l":"İnne ila rabbikerrü´"},{"v":9,"u":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","m":"Gördün mü şu men edeni","l":"Eraeytelleziy yenha"},{"v":10,"u":"عَبۡدًا إِذَا صَلَّىٰٓ","m":"Namaz kılarken bir kulu (Peygamber'i namazdan)","l":"Abden iza salla"},{"v":11,"u":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ","m":"Gördün mü, ya o (Peygamber) doğru yolda olur","l":"Eraeyte in kane ´alelhüda"},{"v":12,"u":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ","m":"Yahut takvayı emrediyorsa","l":"Ev emara bittakva"},{"v":13,"u":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","m":"Ne dersin o (meneden, Peygamber'i) yalanlıyor ve doğru yoldan yüz çeviriyorsa","l":"Eraeyte in kezzebe ve tevella"},{"v":14,"u":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ","m":"(Bu adam) Allah'ın, (yaptıklarını) gördüğünü bilmez mi","l":"Elem ya´lem biennallahe yera"},{"v":15,"u":"كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ","m":"Hayır, hayır! Eğer vazgeçmezse, derhal onu alnından (perçeminden), yakalarız (cehenneme atarız)","l":"Kella lein lem yentehi lenesfe´an binnasıyeh"},{"v":16,"u":"نَاصِيَةࣲ كَٰذِبَةٍ خَاطِئَةࣲ‏","m":"O yalancı, günahkar alından (perçemden)","l":"Nasıyetin kezibetin hatıeh"},{"v":17,"u":"فَلۡيَدۡعُ نَادِيَهُۥ","m":"O, hemen gidip meclisini (kendi taraftarlarını) çağırsın","l":"Felyed´u nadiyehu"},{"v":18,"u":"سَنَدۡعُ ٱلزَّبَانِيَةَ","m":"Biz de zebanileri çağıracağız","l":"Sened´uzzebaniyete"},{"v":19,"u":"كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩","m":"Hayır! Ona uyma! Allah'a secde et ve (yalnızca O'na) yaklaş","l":"Kella la tütı´hü vescüd vakterib"}]}