{"n":114,"ayetler":[{"v":1,"u":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","m":"De ki: Sığınırım ben insanların Rabbine","l":"Kul e´uzü birabbinnas"},{"v":2,"u":"مَلِكِ ٱلنَّاسِ","m":"İnsanların Melikine (mutlak sahip ve hakimine)","l":"Melikinnas"},{"v":3,"u":"إِلَٰهِ ٱلنَّاسِ","m":"İnsanların İlahına","l":"İlahinnas"},{"v":4,"u":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","m":"O sinsi vesvesenin şerrinden","l":"Min şerrilvesvasil hannas"},{"v":5,"u":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","m":"O ki insanların göğüslerine (kötü düşünceler)fısıldar","l":"Elleziy yüvesvisü fiysudurinnas"},{"v":6,"u":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","m":"Gerek cinlerden, gerek insanlardan(olan bütün vesvesecilerin şerrinden Allah'a sığınırım)","l":"Minel cinnetivennas"}]}