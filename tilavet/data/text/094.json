{"n":94,"ayetler":[{"v":1,"u":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","m":"Biz senin göğsünü açıp genişletmedik mi","l":"Elem neşrah leke sadrek"},{"v":2,"u":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","m":"Yükünü senden alıp atmadık mı","l":"Ve vada´na ´anke vizreke"},{"v":3,"u":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ","m":"O senin belini büken yükü","l":"Elleziy enkada zahreke"},{"v":4,"u":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","m":"Senin şanını ve ününü yüceltmedik mi","l":"Ve refa´na leke zikreke"},{"v":5,"u":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","m":"Elbette zorluğun yanında bir kolaylık vardır","l":"Feinne me´al´usri yüsren"},{"v":6,"u":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرࣰا","m":"Gerçekten, zorlukla beraber bir kolaylık daha vardır","l":"İnne me´al´usri yüsren"},{"v":7,"u":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","m":"Boş kaldın mı hemen (başka) işe koyul","l":"Feiza ferağte fensab"},{"v":8,"u":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب","m":"Yalnız Rabbine yönel","l":"Ve ila rabbike ferğab"}]}