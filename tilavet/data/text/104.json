{"n":104,"ayetler":[{"v":1,"u":"وَيۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ","m":"Arkadan çekiştirmeyi, yüze karşı eğlenmeyi adet edinen herkesin vay haline","l":"Veylül li külli hümezetil lümezeh"},{"v":2,"u":"ٱلَّذِي جَمَعَ مَالࣰا وَعَدَّدَهُۥ","m":"O ki, toplamış ve onu sayıp durmuştur","l":"Ellezıcemea malev ve addedeh"},{"v":3,"u":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","m":"malının kendisini ebedi kılacağını zanneder","l":"Yahsebü enne malehu ahledeh"},{"v":4,"u":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","m":"Hayır! Andolsun ki o, Hutame'ye atılacaktır","l":"Kella le yümbezenne fil hutameh"},{"v":5,"u":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","m":"Hutame'nin ne olduğunu bilir misin","l":"Ve ma edrake mel hutameh"},{"v":6,"u":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","m":"Allah'ın, tutuşturulmuş ateşidir","l":"Narullahil mukadeh"},{"v":7,"u":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","m":"(Yandıkça) tırmanıp kalplerin ta üstüne çıkar","l":"Elleti tettaliu alel ef´ideh"},{"v":8,"u":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةࣱ‏","m":"O, onların üzerine kapatılıp kilitlenecektir","l":"İnneha aleyhim mü´sadeh"},{"v":9,"u":"فِي عَمَدࣲ مُّمَدَّدَةِۭ","m":"(Bu ateşin içinde) uzatılmış sütunlara bağlanmışlar","l":"Fi amedim mümeddedeh"}]}