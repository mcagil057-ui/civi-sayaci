{"n":108,"ayetler":[{"v":1,"u":"إِنَّآ أَعۡطَيۡنَٰكَ ٱلۡكَوۡثَرَ","m":"(Resulum!) Kuşkusuz biz sana Kevser'i verdik","l":"İnna a´taynakel kevser"},{"v":2,"u":"فَصَلِّ لِرَبِّكَ وَٱنۡحَرۡ","m":"Şimdi sen Rabbine kulluk et ve kurban kes","l":"Fe salli li rabbike venhar"},{"v":3,"u":"إِنَّ شَانِئَكَ هُوَ ٱلۡأَبۡتَرُ","m":"Asıl sonu kesik olan, şüphesiz sana hınç besleyendir","l":"İnne şanieke hüvel´ebter"}]}