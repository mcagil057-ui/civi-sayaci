{"n":102,"ayetler":[{"v":1,"u":"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ","m":"Çokluk kuruntusu sizi o derece oyaladı ki","l":"Elhakümüt tekasür"},{"v":2,"u":"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ","m":"Nihayet kabirleri ziyaret ettiniz","l":"Hatta zürtümülmekabir"},{"v":3,"u":"كَلَّا سَوۡفَ تَعۡلَمُونَ","m":"Hayır! Yakında bileceksiniz","l":"Kella sevfe ta´lemun"},{"v":4,"u":"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ","m":"Elbette yakında bileceksiniz","l":"Sümme kella sevfe ta´lemun"},{"v":5,"u":"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ","m":"Gerçek öyle değil! Kesin bilgi ile bilmiş olsaydınız","l":"Kella lev ta´lemune ılmel yekıyn"},{"v":6,"u":"لَتَرَوُنَّ ٱلۡجَحِيمَ","m":"Mutlaka cehennem ateşini görürdünüz","l":"Le teravünnelcehıym"},{"v":7,"u":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ","m":"Sonra ahirette onu çıplak gözle göreceksiniz","l":"Sümme leteravünneha aynelyakıyn"},{"v":8,"u":"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ","m":"Nihayet o gün (dünyada yararlandığınız) nimetlerden elbette ve elbette hesaba çekileceksiniz","l":"Sümme le tüs´elünne yevmeizin anin neıym"}]}